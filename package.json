{
  "name": "borderline-rich",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Borderline Rich \u2014 open-world mobile tycoon sim. Start broke. Cross borders. Get rich.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:test": "vite build --mode simtest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "sh check_budget.sh",
    "ci": "npm run typecheck && npm run test && npm run build && npm run budget",
    "check:single": "node scripts/check-single.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
